export default () => ({
  port: parseInt(process.env.PORT || '3000', 10),
  db: resolveDbConfig(),
  rss: {
    pollIntervalMinutes: parseInt(process.env.RSS_POLL_INTERVAL_MINUTES || '10', 10),
  },
