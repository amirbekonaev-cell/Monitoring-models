# PostgreSQL — local docker-compose development. Ignored when DATABASE_URL is set (Vercel/managed
# Postgres deploys use DATABASE_URL instead — see "Деплой на Vercel" in README).
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mentions
# Set to true only if a DB_HOST-based connection also needs SSL (DATABASE_URL always uses SSL
# automatically, this flag is irrelevant when it's set).
DB_SSL=false

# PostgreSQL — Vercel/managed deploy only (Neon/Supabase connection string with sslmode=require).
# Takes priority over DB_HOST/DB_PORT/... above when set. Leave empty for local docker-compose dev.
DATABASE_URL=

# Backend
PORT=3000

# RSS collector (К-2)
RSS_POLL_INTERVAL_MINUTES=10
# RSS feeds only ever expose their last N items — these throttle the additional К-5 deep pass
# (sitemap, or HTML pagination as fallback) layered on top so older material that scrolled out of
# the feed still gets picked up. See README "К-2: глубокий проход поверх RSS".
#
# Since the fix for PARSER-only sources (see README "Исправление: PARSER-источники не проходили
# глубокий обход"), these SAME two variables also throttle the deep pass for К-5 (PARSER) sources
# — a source with no RSS feed at all uses the exact same sitemap/HTML-pagination logic
# (ParserService.deepCollect), just with no separate fast/feed path to fall back to between
# passes. Kept as one pair of variables (not duplicated into PARSER_-prefixed ones) since it's
# genuinely the same setting either way — the "RSS_" prefix on the name is legacy.
RSS_DEEP_SCAN_INTERVAL_HOURS=24
RSS_DEEP_SCAN_LOOKBACK_DAYS=7

# Search/news API collector (К-1) — get a free key at https://newsapi.org/register
NEWSAPI_KEY=
NEWSAPI_POLL_INTERVAL_MINUTES=15

# Telegram collector (К-3) — no token needed, reads the public t.me/s/<channel> preview
TELEGRAM_POLL_INTERVAL_MINUTES=10

# VK social API collector (К-4) — create an app at https://vk.com/apps?act=manage,
# get an access_token with wall/friends scope for newsfeed.search
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
VK_POLL_INTERVAL_MINUTES=15

# Universal page parser (К-5)
PARSER_POLL_INTERVAL_MINUTES=20
# Caps for one deepCollect() sitemap walk — how many sitemap files (index + leaf) get downloaded,
# and how many article URLs get collected from them, before moving on to parsing.
PARSER_MAX_SITEMAP_FILES=20
PARSER_MAX_SITEMAP_ARTICLE_URLS=60

# Бюджет времени /search — backend работает на Vercel Hobby (жёсткий потолок 60с на весь HTTP-
# запрос, см. README "Бюджет времени /search"). SEARCH_TIME_BUDGET_MS — общий дедлайн на весь
# OnDemandSearchService.runSearch() (все каналы, все источники, последовательно); при исчерпании
# оставшиеся источники помечаются пропущенными по тайм-ауту, а не молча обрываются.
# SEARCH_DEEP_SCAN_PHASE_BUDGET_MS — отдельный (меньший) под-бюджет только на фазу RSS+Parser
# (единственные каналы, которые могут запускать sitemap/HTML-пагинацию) — резервирует остаток
# общего бюджета для быстрых одноразовых каналов (Telegram/NewsAPI/VK/OpenAI web search), чтобы
# бэклог глубоких проходов их не забирал целиком (см. инцидент в README). Остальные три — только
# для PARSER-источников (и RSS-канала — он вызывает тот же ParserService.deepCollect()) внутри
# /search конкретно (сколько времени максимум на один источник, сколько статей максимум забирать,
# с какой паузой между запросами) — заметно меньше, чем PARSER_MAX_SITEMAP_ARTICLE_URLS/
# PARSER_CRAWL_DELAY_MS выше, потому что тот бюджет общий на все источники, «созревшие» для
# глубокого прохода в одном /search-вызове, а не на один источник при разовом добавлении.
# PARSER_ONBOARDING_SOURCE_BUDGET_MS — отдельный, куда более щедрый бюджет для «Добавить по
# ссылке» (там всегда ровно один источник на весь HTTP-запрос).
SEARCH_TIME_BUDGET_MS=45000
SEARCH_DEEP_SCAN_PHASE_BUDGET_MS=30000
PARSER_ONDEMAND_SOURCE_BUDGET_MS=10000
PARSER_ONDEMAND_MAX_ARTICLES=15
PARSER_ONDEMAND_CRAWL_DELAY_MS=150
PARSER_ONBOARDING_SOURCE_BUDGET_MS=45000

# К-6: поиск упоминаний по всему интернету через инструмент веб-поиска OpenAI (Responses API,
# tools:[{type:'web_search'}]). OPENAI_API_KEY НИКОГДА не коммитить — только через .env (в
# .gitignore). Платный инструмент (~$10 за 1000 вызовов + токены) — интервал ниже 30 минут
# игнорируется и принудительно поднимается до 30 (см. README). Домен-фильтр
# (filters.allowed_domains) поддерживается на практике только моделями GPT-5+ с веб-поиском
# (проверено вживую: gpt-4o-mini отвечает 400 "filters not supported").
#
# SOCIAL_SEARCH_ENABLED: временно отключает К-6 как канал СБОРА — по умолчанию false на этот
# период. OPENAI_API_KEY при этом не пустует: тот же ключ
# продолжает использоваться отдельно для определения тональности упоминаний (см. ниже),
# независимо от этого флага. Поставьте true, чтобы включить К-6 обратно — см. README "К-6:
# временное отключение".
OPENAI_API_KEY=
SOCIAL_SEARCH_ENABLED=false
OPENAI_SOCIAL_SEARCH_MODEL=gpt-5-mini
OPENAI_SOCIAL_SEARCH_POLL_INTERVAL_MINUTES=45

# Определение тональности упоминаний (Позитив/Негатив/Нейтрал) через обычный запрос (без
# web_search) к OpenAI Responses API — использует тот же OPENAI_API_KEY, что и К-6 выше, но
# отдельную, более дешёвую модель (это просто классификация текста, не поиск). Запускается сразу
# после сохранения каждого нового упоминания, без ожидания результата (fire-and-forget); при
# ошибке/отсутствии ключа тональность остаётся "не определена", вставка упоминания не задерживается.
OPENAI_SENTIMENT_MODEL=gpt-5-mini

# Telegram bot — sends the /search summary and answers /status, /search in a group. NOT the same
# thing as the К-3 collector above (that one reads public channels with no token at all). Create
# the bot via @BotFather, then follow docs/telegram-setup.md to create the group and get its chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any random string (e.g. `openssl rand -hex 32`) — checked against Telegram's
# X-Telegram-Bot-Api-Secret-Token header on every webhook call before it's processed. Set the same
# value here and in Vercel's env vars, then register it with `npm run set-webhook` (see README
# "Деплой на Vercel").
TELEGRAM_WEBHOOK_SECRET=

# Historical catch-up window for a source's first collection cycle, in days (best-effort —
# only enforced when an item's publish date is actually known; a feed/page that can't reach
# this far back, or doesn't expose dates at all, isn't held to it).
BACKFILL_DAYS=60

# Blacklist: comma-separated domains (each entry also covers its subdomains, e.g.
# "qazcloud.kz" blocks "cloud.qazcloud.kz" too) that must never end up in sources or mentions —
# neither as a manually added source nor as a finding from К-1 (NewsAPI) / К-6 (OpenAI web
# search), which search the whole web and have no fixed site list to filter by. See README
# "Исключение доменов (blacklist)".
EXCLUDED_DOMAINS=goszakup.gov.kz,zakup.nationalbank.kz,qazcloud.kz,cloud.qazcloud.kz

# Frontend (baked in at build time)
VITE_API_URL=http://localhost:3000
