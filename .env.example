# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mentions

# Redis (BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379

# Backend
PORT=3000

# RSS collector (К-2)
RSS_POLL_INTERVAL_MINUTES=10

# Search/news API collector (К-1) — get a free key at https://newsapi.org/register
NEWSAPI_KEY=
NEWSAPI_POLL_INTERVAL_MINUTES=15

# Telegram collector (К-3) — no token needed, reads the public t.me/s/<channel> preview
TELEGRAM_POLL_INTERVAL_MINUTES=10

# VK social API collector (К-4) — create an app at https://vk.com/apps?act=manage,
# get an access_token with wall/friends scope for newsfeed.search
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
VK_POLL_INTERVAL_MINUTES=15

# Universal page parser (К-5)
PARSER_POLL_INTERVAL_MINUTES=20

# Telegram notification bot — sends new-mention alerts to a group. NOT the same thing as the
# К-3 collector above (that one reads public channels with no token at all). Create the bot via
# @BotFather, then follow docs/telegram-setup.md to create the group and get its chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Historical catch-up window for a source's first collection cycle, in days (best-effort —
# only enforced when an item's publish date is actually known; a feed/page that can't reach
# this far back, or doesn't expose dates at all, isn't held to it).
BACKFILL_DAYS=60

# Optional simplified ФТ-23: comma-separated allow-list of mention.sourceType values that are
# allowed to trigger a Telegram alert (e.g. "news,other" to skip social/telegram). Everything is
# still collected and stored regardless — this only filters what gets sent to the group. Empty
# (default) means notify for every type.
TELEGRAM_NOTIFY_SOURCE_TYPES=

# Frontend (baked in at build time)
VITE_API_URL=http://localhost:3000
