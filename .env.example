# PostgreSQL — local docker-compose development. Ignored when DATABASE_URL is set (Vercel/managed
# Postgres deploys use DATABASE_URL instead — see "Деплой на Vercel" in README).
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mentions
# Set to true only if a DB_HOST-based connection also needs SSL (DATABASE_URL always uses SSL
# automatically, this flag is irrelevant when it's set).
DB_SSL=false

# PostgreSQL — Vercel/managed deploy only (Neon/Supabase connection string with sslmode=require).
# Takes priority over DB_HOST/DB_PORT/... above when set. Leave empty for local docker-compose dev.
DATABASE_URL=

# Backend
PORT=3000

# RSS collector (К-2)
RSS_POLL_INTERVAL_MINUTES=10
# RSS feeds only ever expose their last N items — these throttle the additional К-5 deep pass
# (sitemap, or HTML pagination as fallback) layered on top so older material that scrolled out of
# the feed still gets picked up. See README "К-2: глубокий проход поверх RSS".
#
# Since the fix for PARSER-only sources (see README "Исправление: PARSER-источники не проходили
# глубокий обход"), these SAME two variables also throttle the deep pass for К-5 (PARSER) sources
# — a source with no RSS feed at all uses the exact same sitemap/HTML-pagination logic
# (ParserService.deepCollect), just with no separate fast/feed path to fall back to between
# passes. Kept as one pair of variables (not duplicated into PARSER_-prefixed ones) since it's
# genuinely the same setting either way — the "RSS_" prefix on the name is legacy.
RSS_DEEP_SCAN_INTERVAL_HOURS=24
RSS_DEEP_SCAN_LOOKBACK_DAYS=7

# Search/news API collector (К-1) — get a free key at https://newsapi.org/register
NEWSAPI_KEY=
NEWSAPI_POLL_INTERVAL_MINUTES=15

# Telegram collector (К-3) — no token needed, reads the public t.me/s/<channel> preview
TELEGRAM_POLL_INTERVAL_MINUTES=10

# VK social API collector (К-4) — create an app at https://vk.com/apps?act=manage,
# get an access_token with wall/friends scope for newsfeed.search
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
VK_POLL_INTERVAL_MINUTES=15

# Universal page parser (К-5)
PARSER_POLL_INTERVAL_MINUTES=20
# Caps for one deepCollect() sitemap walk — how many sitemap files (index + leaf) get downloaded,
# and how many article URLs get collected from them, before moving on to parsing.
PARSER_MAX_SITEMAP_FILES=20
PARSER_MAX_SITEMAP_ARTICLE_URLS=60

# УСТАРЕЛО — не читается никаким кодом с тех пор, как /search перестал опрашивать каналы и стал
# читать только закрытый пул ссылок (см. CuratedSearchService, README "Управление ботом из
# группы"). Раньше ограничивали общий бюджет /search на Vercel Hobby (60с на HTTP-запрос) и
# под-бюджет фазы RSS/Parser deepCollect() внутри самого /search — эта логика полностью удалена
# вместе с OnDemandSearchService. Оставлены закомментированными как история, безопасно удалить
# из настоящего .env, если они там были:
# SEARCH_TIME_BUDGET_MS=45000
# SEARCH_DEEP_SCAN_PHASE_BUDGET_MS=30000
# PARSER_ONDEMAND_SOURCE_BUDGET_MS=10000
# PARSER_ONDEMAND_MAX_ARTICLES=15
# PARSER_ONDEMAND_CRAWL_DELAY_MS=150

# Всё ещё используется — щедрый бюджет на sitemap/HTML-пагинацию deepCollect() для «Добавить по
# ссылке» (SourceOnboardingService, PARSER/RSS-источники): там всегда ровно один источник на весь
# HTTP-запрос, поэтому лимит куда мягче, чем у бывшего /search-прохода выше.
PARSER_ONBOARDING_SOURCE_BUDGET_MS=45000

# Закрытый пул ссылок — /search и /status читают ТОЛЬКО его (см. CuratedSearchService), никогда
# не опрашивают RSS/Parser/Telegram/NewsAPI/VK/OpenAI web search. Сами ссылки обрабатываются
# заранее отдельным скриптом (ПРОМПТ 2), не этим backend-процессом.
#
# SEARCH_PERIOD_DAYS — список периодов для кнопок /search, через запятую. Валидация: целые
# положительные числа, без повторов, строго по возрастанию, каждое ≤3650; при нарушении — warn в
# логах и используется дефолт ниже.
SEARCH_PERIOD_DAYS=1,3,7,14,30,90,180,365,730
# SEARCH_TIMEZONE — часовой пояс, в котором считаются календарные границы периода (dateFrom/dateTo)
# и отображаются даты статей в сообщениях бота.
SEARCH_TIMEZONE=Asia/Almaty
# SEARCH_MESSAGE_CHAR_LIMIT — сколько символов одного Telegram-сообщения /search старается не
# превышать при жадной упаковке находок на одну "страницу" (остальное — по кнопке "Показать ещё").
SEARCH_MESSAGE_CHAR_LIMIT=3500

# К-6: поиск упоминаний по всему интернету через инструмент веб-поиска OpenAI (Responses API,
# tools:[{type:'web_search'}]). OPENAI_API_KEY НИКОГДА не коммитить — только через .env (в
# .gitignore). Платный инструмент (~$10 за 1000 вызовов + токены) — интервал ниже 30 минут
# игнорируется и принудительно поднимается до 30 (см. README). Домен-фильтр
# (filters.allowed_domains) поддерживается на практике только моделями GPT-5+ с веб-поиском
# (проверено вживую: gpt-4o-mini отвечает 400 "filters not supported").
#
# SOCIAL_SEARCH_ENABLED: временно отключает К-6 как канал СБОРА — по умолчанию false на этот
# период. OPENAI_API_KEY при этом не пустует: тот же ключ
# продолжает использоваться отдельно для определения тональности упоминаний (см. ниже),
# независимо от этого флага. Поставьте true, чтобы включить К-6 обратно — см. README "К-6:
# временное отключение".
OPENAI_API_KEY=
SOCIAL_SEARCH_ENABLED=false
OPENAI_SOCIAL_SEARCH_MODEL=gpt-5-mini
OPENAI_SOCIAL_SEARCH_POLL_INTERVAL_MINUTES=45

# Определение тональности упоминаний (Позитив/Негатив/Нейтрал) через обычный запрос (без
# web_search) к OpenAI Responses API — использует тот же OPENAI_API_KEY, что и К-6 выше, но
# отдельную, более дешёвую модель (это просто классификация текста, не поиск). Запускается сразу
# после сохранения каждого нового упоминания, без ожидания результата (fire-and-forget); при
# ошибке/отсутствии ключа тональность остаётся "не определена", вставка упоминания не задерживается.
OPENAI_SENTIMENT_MODEL=gpt-5-mini

# Telegram bot — sends the /search summary and answers /status, /search in a group. NOT the same
# thing as the К-3 collector above (that one reads public channels with no token at all). Create
# the bot via @BotFather, then follow docs/telegram-setup.md to create the group and get its chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# How the bot receives updates: polling | webhook. Leave empty — the default is picked per
# environment and that is almost always what you want: `polling` locally (Telegram cannot POST to
# http://localhost:3000, so a webhook bot answers nothing on the docker compose stand) and
# `webhook` on Vercel (which sets VERCEL itself; a frozen Function instance cannot keep getUpdates
# open). Set it explicitly only for an unusual setup, e.g. `webhook` with the local stand exposed
# through an ngrok tunnel. See README "Как бот получает апдейты".
TELEGRAM_BOT_MODE=
# Any random string (e.g. `openssl rand -hex 32`) — checked against Telegram's
# X-Telegram-Bot-Api-Secret-Token header on every webhook call before it's processed. Set the same
# value here and in Vercel's env vars, then register it with `npm run set-webhook` (see README
# "Деплой на Vercel").
TELEGRAM_WEBHOOK_SECRET=

# Historical catch-up window for a source's first collection cycle, in days (best-effort —
# only enforced when an item's publish date is actually known; a feed/page that can't reach
# this far back, or doesn't expose dates at all, isn't held to it).
BACKFILL_DAYS=60

# Blacklist: comma-separated domains (each entry also covers its subdomains, e.g.
# "qazcloud.kz" blocks "cloud.qazcloud.kz" too) that must never end up in sources or mentions —
# neither as a manually added source nor as a finding from К-1 (NewsAPI) / К-6 (OpenAI web
# search), which search the whole web and have no fixed site list to filter by. See README
# "Исключение доменов (blacklist)".
EXCLUDED_DOMAINS=goszakup.gov.kz,zakup.nationalbank.kz,qazcloud.kz,cloud.qazcloud.kz

# Frontend (baked in at build time)
VITE_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Наполнение закрытого пула ссылок (ПРОМПТ 2) — CuratedIngestService и скрипты
# npm run curated:import / curated:process / curated:status / curated:leak-check.
# Подробности и команды: README, раздел «Наполнение пула».
#
# Сам файл со ссылками лежит в backend/data/curated-links.txt и НЕ коммитится:
# каталог backend/data/ добавлен в .gitignore/.dockerignore/.vercelignore.
# ---------------------------------------------------------------------------

# CURATED_READ_MODE — как читать страницу пула.
#   auto   (по умолчанию) — сначала бесплатный HTTP-парсер; если страница не отдалась,
#            пустая или слишком короткая (анти-бот, JS-рендер) — платное чтение через
#            OpenAI web search, ограниченное доменом самой ссылки.
#   openai — всегда через OpenAI (дороже; нужно только для отладки или для домена,
#            который парсер не берёт в принципе).
# Работает независимо от SOCIAL_SEARCH_ENABLED: тот флаг выключает К-6 как канал сбора.
CURATED_READ_MODE=auto

# Ниже этого объёма текст страницы считается заглушкой, а не статьёй, — включается
# fallback на OpenAI. По смыслу совпадает с порогом «полного текста» в тональности.
CURATED_MIN_PAGE_TEXT_CHARS=400

# Сколько раз пробовать ссылку, прежде чем пометить её failed
# (вернуть к жизни: npm run curated:process -- --retry-failed).
CURATED_MAX_ATTEMPTS=3

# Потолок времени на ОДНУ ссылку целиком (скачивание + OpenAI + тональность), AbortController.
CURATED_LINK_TIMEOUT_MS=25000

# Сколько ссылок обрабатывать одновременно. Относится к РАЗНЫМ хостам: к одному хосту
# всегда идёт строго один запрос за раз (у sknews.kz 49 ссылок подряд — иначе это
# выглядит как скрейп и кончается блокировкой).
CURATED_CONCURRENCY=4

# Пауза между двумя запросами к одному и тому же хосту.
CURATED_HOST_DELAY_MS=300

# Ленивая дообработка внутри /search: перед чтением из БД обработать несколько
# оставшихся (pending) ссылок в пределах бюджета — реально скачать страницы, вытащить дату
# и определить тональность через OpenAI. Ошибка этого шага никогда не ломает чтение из БД.
#
# Это единственный режим, в котором /search действительно что-то собирает, а не просто читает
# уже готовое. Включённым он даёт ровно то поведение, которого ждут от бота: ссылки из пула
# появляются в ленте/дашборде по мере того, как бот до них доходит, а не все сразу. Бот при
# этом отвечает не мгновенно (отсюда статус-сообщение «Ищу упоминания…» перед началом работы) —
# держите бюджет в пределах ~20 с, обработчик обязан уложиться в ~30 с до таймаута Telegram.
# Нужен OPENAI_API_KEY, иначе тональность останется «не определена».
CURATED_LAZY_PROCESS=true
CURATED_LAZY_MAX_LINKS=8
CURATED_LAZY_BUDGET_MS=20000

# CURATED_LINKS_EXPOSE_URLS — отдавать ли ссылки скрытых упоминаний в REST API и фронтенд.
# По умолчанию false: авторизации у API нет, поэтому скрытие сделано на сервере
# (MentionPrivacyInterceptor), а не в вёрстке. На Telegram-бота НЕ влияет — он ссылки
# не показывает никогда ни при каком значении.
CURATED_LINKS_EXPOSE_URLS=false

# --- Аддитивные настройки пула (все по умолчанию выключены = прежнее поведение) ---
# Включайте по одной: каждая из трёх правок независима, и при пустом/отсутствующем значении
# бот и обработка пула ведут себя ровно так, как описано в разделах выше.

# 1. Отсечка по дате статьи. Статья, опубликованная РАНЬШЕ этой даты, не превращается в
#    упоминание: ссылка получает статус not_relevant с причиной в last_error. Статья, вышедшая
#    в сам день порога, остаётся. Статья БЕЗ даты порогом не затрагивается (она и так не входит
#    ни в один период /search и считается отдельно как «без даты»).
#    Формат строго YYYY-MM-DD. Пусто/не задано/некорректно — отсечки нет (в логах warn).
#    Уже созданные упоминания эта настройка не удаляет — для этого есть curated:reset.
# CURATED_MIN_ARTICLE_DATE=2023-01-01

# 2. Длина пересказа для ссылок пула. Промпт тональности общий для всех шести каналов сбора,
#    поэтому число слов передаётся ОДНИМ параметром вызова и только для пула — у остальных
#    каналов промпт остаётся прежним (1-2 предложения, ~250 символов). Схема JSON-ответа та же.
#    Пусто/0 — промпт не меняется ни для кого.
# CURATED_SUMMARY_WORDS=50
#    На сколько символов обрезается summary при показе в /search. Поднимайте вместе с
#    CURATED_SUMMARY_WORDS: для 50 слов нужно ~420, иначе пересказ приедет обрезанным.
# CURATED_SUMMARY_DISPLAY_CHARS=420

# 3. Каждая находка /search — отдельным сообщением (сначала та же шапка, затем по одному
#    сообщению на статью). При false — прежняя упаковка находок в одну «страницу» по
#    SEARCH_MESSAGE_CHAR_LIMIT. Порциями по SEARCH_ITEMS_PER_BATCH за одно нажатие кнопки, с
#    паузой ~700 мс между сообщениями: Telegram ограничивает бота ~20 сообщениями в минуту в
#    группу, а вызов на Vercel жёстко обрывается через 60 с. Остаток — та же кнопка
#    «Показать ещё», с тем же callback_data.
# SEARCH_ONE_ARTICLE_PER_MESSAGE=true
# SEARCH_ITEMS_PER_BATCH=8
