# PostgreSQL — local docker-compose development. Ignored when DATABASE_URL is set (Vercel/managed
# Postgres deploys use DATABASE_URL instead — see "Деплой на Vercel" in README).
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mentions
# Set to true only if a DB_HOST-based connection also needs SSL (DATABASE_URL always uses SSL
# automatically, this flag is irrelevant when it's set).
DB_SSL=false

# PostgreSQL — Vercel/managed deploy only (Neon/Supabase connection string with sslmode=require).
# Takes priority over DB_HOST/DB_PORT/... above when set. Leave empty for local docker-compose dev.
DATABASE_URL=

# Backend
PORT=3000

# Проект собирает упоминания ТОЛЬКО из фиксированного списка источников (docs/sources.txt —
# сайты через RSS/парсер + Telegram-каналы). Каналы, которые искали по всему интернету без
# привязки к конкретному сайту (К-1 NewsAPI, К-4 VK, К-6 OpenAI web search), отключены по
# умолчанию — см. README "Временное отключение К-1/К-4/К-6". Код всех трёх каналов остаётся в
# репозитории и включается обратно одним флагом ниже, без правок кода.

# RSS collector (К-2) — опрашивается раз в 15 минут, как и К-3/К-5 ниже (единый интервал)
RSS_POLL_INTERVAL_MINUTES=15

# Search/news API collector (К-1, отключён по умолчанию) — get a free key at
# https://newsapi.org/register. NEWSAPI_ENABLED=true регистрирует фоновый BullMQ-цикл и включает
# системный источник newsapi://global-search обратно (иначе он в статусе disabled и не опрашивается
# ни фоновым циклом, ни командой /search).
NEWSAPI_KEY=
NEWSAPI_ENABLED=false
NEWSAPI_POLL_INTERVAL_MINUTES=15

# Telegram collector (К-3) — no token needed, reads the public t.me/s/<channel> preview
TELEGRAM_POLL_INTERVAL_MINUTES=15

# VK social API collector (К-4, отключён по умолчанию) — create an app at
# https://vk.com/apps?act=manage, get an access_token with wall/friends scope for newsfeed.search.
# VK_ENABLED=true работает так же, как NEWSAPI_ENABLED выше — включает фоновый цикл и источник
# vk://global-search обратно.
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
VK_ENABLED=false
VK_POLL_INTERVAL_MINUTES=15

# Universal page parser (К-5) — crawls the source's news listing (not just one page): follows
# pagination (rel="next", ?page=N, /page/N/) up to PARSER_MAX_PAGES listing pages per cycle and
# parses every discovered article link. On a source's first (backfill) cycle the depth is
# increased to PARSER_BACKFILL_MAX_PAGES to pull in older material once; every cycle afterwards
# uses the shallow PARSER_MAX_PAGES, since the listing doesn't change much between polls.
PARSER_POLL_INTERVAL_MINUTES=15
PARSER_MAX_PAGES=5
PARSER_BACKFILL_MAX_PAGES=25
PARSER_MAX_ARTICLES_PER_CRAWL=60
PARSER_CRAWL_DELAY_MS=400

# К-6 (отключён по умолчанию): поиск упоминаний по всему интернету через инструмент веб-поиска
# OpenAI (Responses API, tools:[{type:'web_search'}]). OPENAI_API_KEY НИКОГДА не коммитить —
# только через .env (в .gitignore). Платный инструмент (~$10 за 1000 вызовов + токены) — интервал
# ниже 30 минут игнорируется и принудительно поднимается до 30 (см. README). Домен-фильтр
# (filters.allowed_domains) поддерживается на практике только моделями GPT-5+ с веб-поиском
# (проверено вживую: gpt-4o-mini отвечает 400 "filters not supported").
#
# SOCIAL_SEARCH_ENABLED: временно отключает К-6 именно как канал СБОРА (фоновый BullMQ-цикл не
# регистрируется, источник openai-search://web переводится в disabled, /search пропускает этот
# канал) — по умолчанию false. OPENAI_API_KEY при этом не пустует: тот же ключ продолжает
# использоваться отдельно для определения тональности упоминаний (см. ниже), независимо от этого
# флага. Поставьте true, чтобы включить К-6 обратно — см. README "Временное отключение К-1/К-4/К-6".
OPENAI_API_KEY=
SOCIAL_SEARCH_ENABLED=false
OPENAI_SOCIAL_SEARCH_MODEL=gpt-5-mini
OPENAI_SOCIAL_SEARCH_POLL_INTERVAL_MINUTES=45

# Определение тональности упоминаний (Позитив/Негатив/Нейтрал) через обычный запрос (без
# web_search) к OpenAI Responses API — использует тот же OPENAI_API_KEY, что и К-6 выше, но
# отдельную, более дешёвую модель (это просто классификация текста, не поиск). Запускается сразу
# после сохранения каждого нового упоминания, без ожидания результата (fire-and-forget); при
# ошибке/отсутствии ключа тональность остаётся "не определена", вставка упоминания не задерживается.
OPENAI_SENTIMENT_MODEL=gpt-5-mini

# Telegram bot — sends the /search summary and answers /status, /search in a group. NOT the same
# thing as the К-3 collector above (that one reads public channels with no token at all). Create
# the bot via @BotFather, then follow docs/telegram-setup.md to create the group and get its chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any random string (e.g. `openssl rand -hex 32`) — checked against Telegram's
# X-Telegram-Bot-Api-Secret-Token header on every webhook call before it's processed. Set the same
# value here and in Vercel's env vars, then register it with `npm run set-webhook` (see README
# "Деплой на Vercel").
TELEGRAM_WEBHOOK_SECRET=

# Historical catch-up window for a source's first collection cycle, in days (best-effort —
# only enforced when an item's publish date is actually known; a feed/page that can't reach
# this far back, or doesn't expose dates at all, isn't held to it).
BACKFILL_DAYS=60

# Blacklist: comma-separated domains (each entry also covers its subdomains, e.g.
# "qazcloud.kz" blocks "cloud.qazcloud.kz" too) that must never end up in sources or mentions —
# neither as a manually added source nor as a finding from К-1 (NewsAPI) / К-6 (OpenAI web
# search), which search the whole web and have no fixed site list to filter by. See README
# "Исключение доменов (blacklist)".
EXCLUDED_DOMAINS=goszakup.gov.kz,zakup.nationalbank.kz,qazcloud.kz,cloud.qazcloud.kz

# Frontend (baked in at build time)
VITE_API_URL=http://localhost:3000
