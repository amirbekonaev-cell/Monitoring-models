# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mentions

# Redis (BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379

# Backend
PORT=3000

# RSS collector
RSS_POLL_INTERVAL_MINUTES=10

# Telegram notification bot (see docs/telegram-setup.md) — fill in after creating the bot/group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_NOTIFY_SOURCE_TYPES=
BACKFILL_DAYS=
OPENAI_API_KEY=
EXCLUDED_DOMAINS=goszakup.gov.kz,zakup.nationalbank.kz,qazcloud.kz,cloud.qazcloud.kz

# Closed-pool /search & /status (see CuratedSearchService, README) — added by feature/curated-bot,
# see .env.example for full docs on each.
SEARCH_PERIOD_DAYS=1,3,7,14,30,90,180,365,730
SEARCH_TIMEZONE=Asia/Almaty
SEARCH_MESSAGE_CHAR_LIMIT=3500

# Frontend (baked in at build time)
VITE_API_URL=https://monitoring-models.vercel.app

# Наполнение закрытого пула ссылок (ПРОМПТ 2) — см. .env.example и README
CURATED_READ_MODE=auto
CURATED_MIN_PAGE_TEXT_CHARS=400
CURATED_MAX_ATTEMPTS=3
CURATED_LINK_TIMEOUT_MS=25000
CURATED_CONCURRENCY=4
CURATED_HOST_DELAY_MS=300
CURATED_LAZY_PROCESS=false
CURATED_LAZY_MAX_LINKS=10
CURATED_LAZY_BUDGET_MS=20000
CURATED_LINKS_EXPOSE_URLS=false
